# ============================================================
# AIA Backend — Environment Variables
#
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# ── Supabase ─────────────────────────────────────────────────
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Auth ─────────────────────────────────────────────────────
SITE_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── AI Runtime ───────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_DEFAULT_MODEL=gpt-4o

# ── Level A: Platform Integrations ───────────────────────────
# SMS
PLATFORM_SMS_PROVIDER=           # twilio | kavenegar
PLATFORM_SMS_API_KEY=
PLATFORM_SMS_SENDER_ID=

# Email
PLATFORM_EMAIL_PROVIDER=         # resend | sendgrid
PLATFORM_EMAIL_API_KEY=
PLATFORM_EMAIL_FROM=noreply@aia.app

# WhatsApp
PLATFORM_WHATSAPP_PROVIDER=      # twilio | meta
PLATFORM_WHATSAPP_API_KEY=
PLATFORM_WHATSAPP_PHONE_NUMBER=

# Payment (Level A billing only — NOT for tenant orders)
PLATFORM_PAYMENT_GATEWAY=        # stripe | zarinpal
PLATFORM_PAYMENT_API_KEY=
PLATFORM_PAYMENT_WEBHOOK_SECRET=

# ── Automation ───────────────────────────────────────────────
N8N_WEBHOOK_URL=
N8N_API_KEY=
